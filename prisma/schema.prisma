generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  notes     String?
  birthday  String?
  tags      String[] @default([])
  createdAt DateTime @default(now())

  planSubscriptions PlanSubscription[]
  appointments      Appointment[]
  payments          Payment[]
  whatsappLogs      WhatsappLog[]
}

model Plan {
  id           String @id @default(cuid())
  name         String
  sessions     Int
  price        Float
  validityDays Int

  subscriptions PlanSubscription[]
}

model PlanSubscription {
  id           String    @id @default(cuid())
  clientId     String
  planId       String
  sessionsUsed Int       @default(0)
  purchasedAt  DateTime  @default(now())
  expiresAt    DateTime?
  active       Boolean   @default(true)

  client Client @relation(fields: [clientId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])
}

model Appointment {
  id                 String            @id @default(cuid())
  clientId           String?
  googleEventId      String?           @unique
  serviceType        String            @default("Massagem")
  title              String
  startTime          DateTime
  endTime            DateTime
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?
  sessionNotes       String?
  cancelReason       String?
  confirmedAt        DateTime?
  confirmationSentAt DateTime?
  recurrenceId       String?
  /// Pacote usado ao concluir (o Reabrir devolve a sessão)
  planSubscriptionId String?
  /// Atendimento em parceria com outra massoterapeuta (cliente dela, sem cadastro)
  isPartner          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  client   Client?   @relation(fields: [clientId], references: [id])
  payments Payment[]
}

model BlockedSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Service {
  id             String  @id @default(cuid())
  name           String
  durationMins   Int
  price          Float
  active         Boolean @default(true)
  /// Textos do modal de detalhes na vitrine
  description    String?
  sessionDetails String?
}

model Payment {
  id             String        @id @default(cuid())
  clientId       String?
  appointmentId  String?
  amount         Float
  status         PaymentStatus @default(PENDING)
  pixCode        String?
  pixQrCode      String?
  mpPaymentId    String?       @unique
  linkSentAt     DateTime?
  paidAt         DateTime?
  /// Criada pelo "Concluir" da agenda; o "Reabrir" remove
  fromCompletion Boolean       @default(false)
  /// Pagamento de um pacote de sessões
  planSubscriptionId String?
  /// Como estava antes do "Concluir" (o "Reabrir" restaura)
  preCompletionStatus String?
  preCompletionAmount Float?
  createdAt      DateTime      @default(now())

  client      Client?      @relation(fields: [clientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

model WhatsappLog {
  id       String      @id @default(cuid())
  clientId String
  type     MessageType
  message  String
  status   String      @default("sent")
  sentAt   DateTime    @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model SyncLog {
  id              String   @id @default(cuid())
  syncedAt        DateTime @default(now())
  eventsProcessed Int      @default(0)
  errors          String?
}

model Settings {
  id                         String   @id @default("singleton")
  confirmationTemplate       String?
  paymentTemplate            String?
  reengagementTemplate       String?
  noShowTemplate             String?
  /// Liga/desliga de cada mensagem automática
  confirmationEnabled         Boolean  @default(true)
  paymentEnabled              Boolean  @default(true)
  reengagementEnabled         Boolean  @default(true)
  noShowEnabled               Boolean  @default(true)
  confirmationDaysBefore     Int      @default(1)
  confirmationSendHour       Int      @default(9)
  reengagementInactivityDays Int      @default(15)
  reengagementCooldownDays   Int      @default(15)
  monthlyGoal                Float?
  /// Jornada por dia da semana: { "1": { "start": "08:00", "end": "18:00" }, ... } (dia ausente = folga)
  workSchedule               Json?
  updatedAt                  DateTime @updatedAt
}

model VitrineContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Foto do carrossel da galeria da vitrine (ordem crescente de `position`).
model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Avaliação do Google. Chega pelo scraper como PENDING (ou à mão como APPROVED);
/// só as APPROVED aparecem na vitrine.
model GoogleReview {
  id           String       @id @default(cuid())
  /// data-review-id do Google; nulo nas cadastradas à mão
  externalId   String?      @unique
  author       String
  rating       Int
  text         String       @default("")
  /// Data aproximada (o Google só mostra "há 2 semanas")
  publishedAt  DateTime?
  status       ReviewStatus @default(PENDING)
  source       ReviewSource @default(GOOGLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ReviewSource {
  GOOGLE
  MANUAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  /// Cancelada: fica no histórico, fora dos totais e das listas
  CANCELLED
}

enum MessageType {
  CONFIRMATION
  PAYMENT_LINK
  REENGAGEMENT
  NO_SHOW
}
